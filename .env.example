# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (e.g. https://your-project.vercel.app).
VITE_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION (Optional - if omitted, app runs in offline demo mode):
# Set these in your Vercel Project Settings > Environment Variables when ready.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# BREVO EMAIL API KEY (Set this in Vercel / hosting environment variables):
BREVO_API_KEY="your-brevo-api-key"
VITE_BREVO_API_KEY="your-brevo-api-key"

